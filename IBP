      msg = "¡PICO INFLACIONARIO! Costos de materia prima aumentan 25%. Ajuste su conciliación financiera.";
      impact = { ebitda: -4.0 };
    } else if (type === 'rubberband') {
      msg = "¡VENTURE CAPITAL GRANT! El equipo rezagado recibe subsidio de optimización logística (+150 pts).";
    }

    // Apply impact to teams
    const updatedTeams = { ...gameState.teams };
    Object.keys(updatedTeams).forEach(id => {
      if (type === 'rubberband') {
        // Find team with lowest score
        const lowestId = Object.keys(updatedTeams).reduce((a, b) => updatedTeams[a].score < updatedTeams[b].score ? a : b);
        if (id === lowestId) updatedTeams[id].score += 150;
      } else {
        if (!updatedTeams[id].ShieldActive) {
          if (impact.otif) updatedTeams[id].otif = Math.max(40, updatedTeams[id].otif + impact.otif);
          if (impact.ebitda) updatedTeams[id].ebitda = Math.max(2, parseFloat((updatedTeams[id].ebitda + impact.ebitda).toFixed(1)));
          if (impact.inventoryTurn) updatedTeams[id].inventoryTurn = Math.max(1, parseFloat((updatedTeams[id].inventoryTurn + impact.inventoryTurn).toFixed(1)));
          updatedTeams[id].score = Math.max(0, updatedTeams[id].score - 50);
        }
      }
    });

    syncState({
      ...gameState,
      tickerMessage: msg,
      marketEvent: type,
      teams: updatedTeams
    });
  };

  const updateTeamScore = (teamId, delta) => {
    const updatedTeams = { ...gameState.teams };
    if (updatedTeams[teamId]) {
      updatedTeams[teamId].score = Math.max(0, updatedTeams[teamId].score + delta);
      // Improve KPIs on positive points
      if (delta > 0) {
        updatedTeams[teamId].otif = Math.min(99, updatedTeams[teamId].otif + 2);
        updatedTeams[teamId].forecastAccuracy = Math.min(98, updatedTeams[teamId].forecastAccuracy + 2);
      }
    }
    syncState({ ...gameState, teams: updatedTeams });
  };

