  const triggerMarketDisruption = (type) => {
    let msg = "";
    let impact = {};
    if (type === 'suez') {
      msg = "¡CRISIS GLOBAL! Bloqueo del Canal de Suez interrumpe envíos. Tiempos de entrega +40%.";
      impact = { otif: -15, ebitda: -2.5 };
    } else if (type === 'chips') {
      msg = "¡ESCASEZ DE SEMICONDUCTORES! La capacidad de suministro global cae un 30%.";
      impact = { inventoryTurn: -1.2, otif: -10 };
