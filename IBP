];

export default function App() {
  // App view modes: 'projector' | 'moderator' | 'player'
  const [viewMode, setViewMode] = useState('projector');
  const [user, setUser] = useState(null);
  const [gameState, setGameState] = useState(INITIAL_GAME_STATE);
  const [selectedTeamId, setSelectedTeamId] = useState('team1');

  // Interactive state for team answers inside missions
  const [demandSlider, setDemandSlider] = useState(100);
  const [capacitySlider, setCapacitySlider] = useState(85);
  const [bufferSlider, setBufferSlider] = useState(15);
  const [selectedTool, setSelectedTool] = useState('');
  const [missionSubmitted, setMissionSubmitted] = useState(false);

  // Auth setup
  useEffect(() => {
    if (!auth) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth error:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (u) => setUser(u));
    return () => unsubscribe();
  }, []);

  // Firestore sync setup
  useEffect(() => {
    if (!db || !user) return;
    const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'ibp_game_room', 'current');
    
    // Subscribe to live changes
    const unsubscribe = onSnapshot(roomRef, (snapshot) => {
      if (snapshot.exists()) {
        setGameState(snapshot.data());
      } else {
        // Initialize doc if missing
        setDoc(roomRef, INITIAL_GAME_STATE).catch(console.error);
      }
    }, (error) => {
      console.warn("Firestore snapshot error (using local state fallback):", error);
    });

    return () => unsubscribe();
  }, [user]);

  // Master Timer Tick (Run by Moderator or active tab)
  useEffect(() => {
    let interval = null;
    if (gameState.isTimerRunning && gameState.roundTimer > 0) {
      interval = setInterval(() => {
        setGameState(prev => {
          const nextTimer = prev.roundTimer - 1;
          const updated = { ...prev, roundTimer: nextTimer };
          // Push update if Firestore active & user is moderator
          if (db && user && viewMode === 'moderator') {
            const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'ibp_game_room', 'current');
            updateDoc(roomRef, { roundTimer: nextTimer }).catch(() => {});
          }
          return updated;
        });
      }, 1000);
    }
    return () => clearInterval(interval);
